# ==============================================================================
# Invoicer API - Environment Variables Example
# Copy this file to .env and adjust values for your local environment:
# cp .env.example .env
# ==============================================================================

# PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres_password_change_me
DB_NAME=invoicer_db
DB_PORT=5432

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@invoicer.local
PGADMIN_DEFAULT_PASSWORD=admin_password_change_me
PGADMIN_PORT=5050
